# Resend — proveedor de correo transaccional (decisión S-0012)
RESEND_API_KEY=
# Remitente verificado. Sin dominio verificado, Resend sólo envía a la dirección del titular.
# Formato: Nombre visible <buzon@dominio-verificado>. Con comillas: lo lee el shell y Next.js.
RESEND_FROM="Nexus Strategy & Technology <presupuestos@executivelab.ai>"
