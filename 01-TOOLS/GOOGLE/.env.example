# Google Workspace — registro de respaldo (hoja de cálculo) y página de citas
# JSON completo de la cuenta de servicio, en una sola línea.
GOOGLE_SERVICE_ACCOUNT_JSON=
# ID de la hoja: la parte larga de su URL, entre /d/ y /edit
GOOGLE_SHEET_ID=
# Página de citas COMPARTIDA del equipo (decisión C-07), no la agenda de un socio
NEXT_PUBLIC_CALENDAR_URL=
