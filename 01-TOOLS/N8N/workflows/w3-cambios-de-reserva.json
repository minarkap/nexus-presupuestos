    {
      "id": "9e5759fa-4271-457b-8901-298fff232414",
      "name": "¿Cancelada, movida o nada relevante?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        96
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const evento = $(\"Cita cambiada en «Llamada de alcance»\").isExecuted ? $(\"Cita cambiada en «Llamada de alcance»\").item.json : $(\"Cita cancelada en «Llamada de alcance»\").item.json;\nconst inv = $(\"Investigación de esta cita\").item.json;\nconst lead = $json || {};\nconst nuevo = evento.start?.dateTime ?? evento.start?.date ?? null;\nconst antes = inv.booking_starts_at;\nconst cancelada = evento.status === \"cancelled\";\nconst movida = !cancelada && nuevo && antes && new Date(nuevo).getTime() !== new Date(antes).getTime();\nreturn { json: { que: cancelada ? \"cancelada\" : (movida ? \"movida\" : \"nada\"), investigacion_id: inv.id, prep_event_id: inv.prep_event_id, nuevo_inicio: nuevo, empresa: lead.contact_company ?? \"(lead ya caducado)\", persona: lead.contact_name ?? \"\" } };"
      }
    },
