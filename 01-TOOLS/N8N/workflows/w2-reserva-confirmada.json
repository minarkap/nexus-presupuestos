      "name": "¿Es una reserva? (provisional, spike S-1)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        288
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const salida = [];\nfor (const item of $input.all()) {\n  const e = item.json;\n  const invitados = Array.isArray(e.attendees) ? e.attendees : [];\n  const reservante = invitados.find((a) => !a.self && !a.organizer && a.email);\n  if (!reservante) continue;\n  salida.push({ json: {\n    event_id: e.id,\n    starts_at: e.start?.dateTime ?? e.start?.date,\n    booker_email: String(reservante.email).toLowerCase(),\n    booker_name: reservante.displayName ?? reservante.email,\n  } });\n}\nreturn salida;"
      }
    },
