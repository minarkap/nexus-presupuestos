    {
      "id": "c917d0e7-13d9-4591-9316-afa70a312e00",
      "name": "Perplexity: la empresa",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1568,
        576
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.perplexity.ai/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: \"sonar-pro\", temperature: 0.1, response_format: { type: \"json_schema\", json_schema: { schema: {\"type\":\"object\",\"required\":[\"claims\",\"summary\"],\"properties\":{\"claims\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"required\":[\"topic\",\"text\",\"source_url\",\"confidence\",\"possible_homonym\"],\"properties\":{\"topic\":{\"type\":\"string\"},\"text\":{\"type\":\"string\"},\"source_url\":{\"type\":\"string\"},\"confidence\":{\"type\":\"string\",\"enum\":[\"alta\",\"media\",\"baja\"]},\"possible_homonym\":{\"type\":\"boolean\"}}}},\"summary\":{\"type\":\"string\"}}} } }, messages: [ { role: \"system\", content: \"Eres un analista que prepara una primera llamada comercial de una consultora. Buscas SOLO información pública y profesional. Reglas que no se rompen: 1) Cada afirmación lleva la URL de la fuente donde la has leído; si no tienes fuente, no la escribas. 2) Nada de vida privada, familia, domicilio, redes personales, ni datos de salud, ideología, religión, afiliación sindical, orientación sexual u origen étnico; si una fuente los menciona, ignóralos. 3) Si hay varias personas u organizaciones con el mismo nombre y no puedes distinguirlas con certeza, márcalo con possible_homonym = true y no mezcles sus datos. 4) No deduzcas ni inventes; «no encontrado» es una respuesta válida. 5) Responde en español y solo con el JSON pedido.\" }, { role: \"user\", content: \"Organización: «\" + $(\"Buscar el lead de ese correo\").item.json.contact_company + \"». Dominio del correo de contacto: «\" + $(\"Buscar el lead de ese correo\").item.json.contact_email.split(\"@\")[1] + \"». País probable: Andorra o España. Quiero: a qué se dedica, sector, tamaño aproximado, sedes, noticias de los últimos 18 meses y señales públicas sobre su tecnología, sus datos o sus procesos.\" } ] }) }}"
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "c8139efe-820f-445a-9e4a-0cad58d36228",
      "name": "Perplexity: la persona",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1792,
        512
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.perplexity.ai/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: \"sonar-pro\", temperature: 0.1, response_format: { type: \"json_schema\", json_schema: { schema: {\"type\":\"object\",\"required\":[\"claims\",\"summary\"],\"properties\":{\"claims\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"required\":[\"topic\",\"text\",\"source_url\",\"confidence\",\"possible_homonym\"],\"properties\":{\"topic\":{\"type\":\"string\"},\"text\":{\"type\":\"string\"},\"source_url\":{\"type\":\"string\"},\"confidence\":{\"type\":\"string\",\"enum\":[\"alta\",\"media\",\"baja\"]},\"possible_homonym\":{\"type\":\"boolean\"}}}},\"summary\":{\"type\":\"string\"}}} } }, messages: [ { role: \"system\", content: \"Eres un analista que prepara una primera llamada comercial de una consultora. Buscas SOLO información pública y profesional. Reglas que no se rompen: 1) Cada afirmación lleva la URL de la fuente donde la has leído; si no tienes fuente, no la escribas. 2) Nada de vida privada, familia, domicilio, redes personales, ni datos de salud, ideología, religión, afiliación sindical, orientación sexual u origen étnico; si una fuente los menciona, ignóralos. 3) Si hay varias personas u organizaciones con el mismo nombre y no puedes distinguirlas con certeza, márcalo con possible_homonym = true y no mezcles sus datos. 4) No deduzcas ni inventes; «no encontrado» es una respuesta válida. 5) Responde en español y solo con el JSON pedido.\" }, { role: \"user\", content: \"Persona: «\" + $(\"Buscar el lead de ese correo\").item.json.contact_name + \"», que trabaja en «\" + $(\"Buscar el lead de ese correo\").item.json.contact_company + \"» (dominio «\" + $(\"Buscar el lead de ese correo\").item.json.contact_email.split(\"@\")[1] + \"»). Quiero SOLO su perfil profesional público: cargo actual, trayectoria profesional y presencia profesional pública (ponencias, artículos, entrevistas). Búscala siempre junto a su empresa.\" } ] }) }}"
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "353d1912-540b-476a-80cf-45a18c6165e8",
      "name": "Filtrar y componer el informe (CA-17a)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2016,
        432
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const leer = (nodo) => { try { return JSON.parse($(nodo).first().json.choices[0].message.content); } catch (e) { return { claims: [], summary: \"\" }; } };\nconst conFuente = (c) => typeof c.source_url === \"string\" && /^https?:\\/\\//.test(c.source_url) && c.text;\nconst marca = (c) => (c.possible_homonym || c.confidence === \"baja\" ? \"⚠️ \" : \"\") + c.text + \" — fuente: \" + c.source_url;\nconst empresa = leer(\"Perplexity: la empresa\");\nconst persona = leer(\"Perplexity: la persona\");\nconst ce = (empresa.claims || []).filter(conFuente);\nconst cp = (persona.claims || []).filter(conFuente);\nconst lead = $(\"Buscar el lead de ese correo\").first().json;\nconst reserva = $(\"¿Es una reserva? (provisional, spike S-1)\").first().json;\nconst cargo = (cp.find((c) => /cargo|puesto|rol|posici/i.test(c.topic)) || {}).text || \"cargo no encontrado\";\nconst fecha = DateTime.fromISO(reserva.starts_at).setZone(\"Europe/Madrid\").setLocale(\"es\").toFormat(\"d LLL yyyy HH:mm\");\nconst titulo = \"Preparación · \" + lead.contact_company + \" · \" + lead.contact_name + \" · \" + fecha;\nconst texto = [\n  \"Punto de partida para la llamada, no un veredicto. Las afirmaciones marcadas con ⚠️ pueden ser de otra persona u organización con el mismo nombre. Todo lo que hay aquí es público y lleva su fuente.\",\n  \"\", \"Resumen\", (empresa.summary || \"—\") + \" \" + lead.contact_name + \": \" + cargo + \".\",\n  \"\", \"La empresa\", ...(ce.length ? ce.map((c) => \"• \" + marca(c)) : [\"• No se encontró nada con fuente.\"]),\n  \"\", \"La persona (solo perfil profesional)\", ...(cp.length ? cp.map((c) => \"• \" + marca(c)) : [\"• No se encontró nada con fuente.\"]),\n  \"\", \"Del formulario\", \"Servicio que encaja: \" + (lead.service_label || \"sin catalogar\") + \". Respuestas completas: correo interno del \" + String(lead.submitted_at).slice(0, 10) + \".\",\n  \"\", \"Este documento se borra solo doce meses después de que \" + lead.contact_name + \" enviara el formulario.\"\n].join(\"\\n\");\nreturn [{ json: { titulo, texto, resumen: (empresa.summary || \"\").slice(0, 400), cargo, informe: { empresa: ce, persona: cp }, event_id: reserva.event_id, starts_at: reserva.starts_at, submission_id: lead.submission_id, empresa_nombre: lead.contact_company, persona_nombre: lead.contact_name } }];"
      }
    },
